{
  "name": "psd-gaming",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:emu": "firebase emulators:exec --only firestore,auth --project psd-gaming-local \"npm run dev\"",
    "emulators": "firebase emulators:start --only firestore,auth --project psd-gaming-local",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test",
    "typecheck": "tsc -p jsconfig.json",
    "test:rules": "firebase emulators:exec --only firestore,auth --project psd-gaming-local \"node --test tests/rules-emulator.test.js\"",
    "audit": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "firebase": "^11.8.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase-tools": "^15.32.0",
    "jsdom": "^30.1.1",
    "typescript": "^7.0.2",
    "vite": "^6.3.5"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.5"
  }
}
