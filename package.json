{
  "name": "psd-gaming",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:emu": "firebase emulators:exec --only firestore,auth --project psd-gaming-local \"npm run dev\"",
    "emulators": "firebase emulators:start --only firestore,auth --project psd-gaming-local",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test",
    "test:rules": "firebase emulators:exec --only firestore,auth --project psd-gaming-local \"node --test tests/rules-emulator.test.js\"",
    "audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "firebase": "^11.8.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase-tools": "^15.32.0",
    "vite": "^6.3.5"
  }
}
