# PSD-gaming environment example.
# Local development: copy this file to .env.local, fill in the value, then restart `npm run dev`.
#   cp .env.example .env.local
#
# VITE_FIREBASE_CONFIG is the Firebase *Web app* config written as ONE line of raw JSON:
#   - Firebase Console -> Project settings -> General -> Your apps -> Web app -> SDK setup and configuration -> Config
#   - Firebase shows a JavaScript object. Convert it to JSON: every key AND every value in "double quotes".
#   - No extra quotes around the whole value, no `const firebaseConfig =`, no trailing `;`.
#   - On Vercel, paste only the {...} part as the variable value (Settings -> Environment Variables),
#     enable it for Production and Preview, then REDEPLOY. Vite embeds VITE_* values at build time.
#
# This config is public browser configuration, not a secret: it ships inside the built site.
# NEVER put a service-account JSON, Admin SDK private key, or OAuth client secret in any VITE_* value.
# The build stops with an error if it detects one.
VITE_FIREBASE_CONFIG={"apiKey":"...","authDomain":"...","projectId":"...","storageBucket":"...","messagingSenderId":"...","appId":"..."}

# Optional, build-time only (deliberately NOT a VITE_ variable, so it is never sent to the browser):
# make the build fail instead of just warning when VITE_FIREBASE_CONFIG is missing or invalid.
# Useful for the Production environment on Vercel.
# REQUIRE_FIREBASE_CONFIG=1
