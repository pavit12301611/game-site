# PSD-gaming environment example.
# Local development: copy this file to .env.local, replace every placeholder, then restart `npm run dev`.
#   cp .env.example .env.local
#
# One variable per Firebase Web config field. Get every value from:
#   Firebase Console -> Project settings -> General -> Your apps -> Web app -> SDK setup and configuration -> Config
#
# Rules for the values:
#   - Paste the bare value only: NO quotes, no trailing comma, no trailing semicolon.
#       right:  VITE_FIREBASE_PROJECT_ID=my-arcade
#       wrong:  VITE_FIREBASE_PROJECT_ID="my-arcade",
#   - On Vercel: Project -> Settings -> Environment Variables. Add each VITE_FIREBASE_* name below with its
#     own value, enable it for Production AND Preview, then REDEPLOY. Vite embeds VITE_* values at build time.
#
# This config is public browser configuration, not a secret: it ships inside the built site.
# NEVER put a service-account JSON, Admin SDK private key, or OAuth client secret in any VITE_* value.
# The build stops with an error if it detects one.

# Firebase "apiKey"
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
# Firebase "authDomain" (bare host, no https://)
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# Firebase "projectId"
VITE_FIREBASE_PROJECT_ID=your-project
# Firebase "storageBucket" (optional)
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
# Firebase "messagingSenderId" (optional)
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
# Firebase "appId"
VITE_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID
# Firebase "measurementId" (optional; this app does not use Analytics, so you can leave it out)
# VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional, build-time only (deliberately NOT a VITE_ variable, so it is never sent to the browser):
# make the build fail instead of just warning when the Firebase config is missing or invalid.
# Useful for the Production environment on Vercel.
# REQUIRE_FIREBASE_CONFIG=1

# Older alternative (still supported): the whole config as ONE line of raw JSON. It is only used when none of
# the VITE_FIREBASE_* variables above has a value, so remove or comment out the placeholders above if you use it.
# VITE_FIREBASE_CONFIG={"apiKey":"...","authDomain":"...","projectId":"...","storageBucket":"...","messagingSenderId":"...","appId":"..."}
