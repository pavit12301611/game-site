{
  "compilerOptions": {
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "moduleResolution": "bundler",
    "module": "ESNext",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowImportingTsExtensions": true,
    "noImplicitAny": false
  },
  "include": ["src/**/*", "shared/**/*"]
}