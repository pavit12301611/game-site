rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // PSD Gaming - Production Firestore Rules
    // Philosophy: Browser sirf READ karta hai, WRITE sab backend (Vercel /api/* + Admin SDK) karta hai
    // Isliye yahan allow create,update,delete = false hai - ye bug nahi, security hai
    // ============================================================

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.admin == true;
    }

    function isRoomMember(roomData) {
      return signedIn()
        && roomData.playerUids is list
        && roomData.playerUids.hasAny([request.auth.uid]);
    }

    // ---------- ADMINS ----------
    // Pehla admin manually console se banta hai, uske baad admin studio se manage hota hai
    match /admins/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['admin'])
        && request.resource.data.admin is bool;
      allow delete: if isAdmin() && request.auth.uid != uid; // khud ko delete nahi kar sakta
    }

    // ---------- MAINTENANCE MODE ----------
    // Public notice - bina login ke sab padh sakte hain
    // FIX: is int -> is number (JS SDK kabhi double bhej deta hai, isliye number accept karo)
    match /siteStatus/{document} {
      allow get: if true;
      allow list: if false;
      allow create, update: if isAdmin()
        && document == 'maintenance'
        && request.resource.data.keys().hasOnly(['enabled', 'reason', 'updatedAtMs', 'updatedByUid', 'pinHash', 'pinSalt', 'pinExpiresAtMs', 'pinSetAtMs'])
        && request.resource.data.keys().hasAll(['enabled', 'reason', 'updatedAtMs', 'updatedByUid', 'pinHash', 'pinSalt', 'pinExpiresAtMs', 'pinSetAtMs'])
        && request.resource.data.enabled is bool
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 500
        && request.resource.data.updatedAtMs is number
        && request.resource.data.updatedByUid == request.auth.uid
        && request.resource.data.pinHash is string
        && request.resource.data.pinHash.size() <= 96
        && request.resource.data.pinSalt is string
        && request.resource.data.pinSalt.size() <= 32
        && request.resource.data.pinExpiresAtMs is number
        && request.resource.data.pinExpiresAtMs >= 0
        && request.resource.data.pinSetAtMs is number
        && request.resource.data.pinSetAtMs >= 0;
      allow delete: if false;
    }

    // 16-digit code - sirf admin padh sakta hai, public kabhi nahi
    match /maintenanceAccess/{document} {
      allow get: if isAdmin() && document == 'active';
      allow list: if false;
      allow create, update: if isAdmin()
        && document == 'active'
        && request.resource.data.keys().hasOnly(['pin', 'pinHash', 'pinSalt', 'expiresAtMs', 'setAtMs', 'hours', 'updatedByUid'])
        && request.resource.data.keys().hasAll(['pin', 'pinHash', 'pinSalt', 'expiresAtMs', 'setAtMs', 'hours', 'updatedByUid'])
        && request.resource.data.pin is string
        && request.resource.data.pin.matches('^[0-9]{16}$')
        && request.resource.data.pinHash is string
        && request.resource.data.pinHash.size() <= 96
        && request.resource.data.pinSalt is string
        && request.resource.data.pinSalt.size() <= 32
        && request.resource.data.expiresAtMs is number
        && request.resource.data.expiresAtMs > 0
        && request.resource.data.setAtMs is number
        && request.resource.data.hours is number
        && request.resource.data.hours >= 1
        && request.resource.data.hours <= 720
        && request.resource.data.updatedByUid == request.auth.uid;
      allow delete: if isAdmin();
    }

    // ---------- PROFILES & USERNAMES ----------
    // Profile private hai - sirf owner + admin dekh sakta hai, list sirf admin
    // Username claim backend se hota hai (claimUsername callable)
    match /profiles/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }

    match /usernames/{usernameLower} {
      // Reservation server-only, client kabhi read/write nahi karta
      allow read, write: if false;
    }

    // ---------- SOCIAL ----------
    match /friendRequests/{requestId} {
      allow get: if signedIn()
        && (resource == null || resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid)
        || isAdmin();
      allow list: if (signedIn()
          && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid))
        || isAdmin();
      allow create, update: if false; // backend: sendFriendRequest, respondFriendRequest
      allow delete: if isAdmin();
    }

    match /friendships/{friendshipId} {
      allow get, list: if (signedIn() && request.auth.uid in resource.data.memberUids)
        || isAdmin();
      allow create, update: if false;
      allow delete: if isAdmin();
    }

    match /gameInvites/{inviteId} {
      allow get: if signedIn()
        && (resource == null || resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid)
        || isAdmin();
      allow list: if (signedIn()
          && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid))
        || isAdmin();
      allow create, update: if false;
      allow delete: if isAdmin();
    }

    match /blocks/{blockId} {
      allow get, list: if signedIn() && request.auth.uid == resource.data.blockerUid
        || isAdmin();
      allow create, update, delete: if false; // backend: blockUser, unblockUser
    }

    match /reports/{reportId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if false; // backend: reportProblem
    }

    // ---------- REVIEWS ----------
    // Public review wall - bina login ke sab padh sakte hain, likhna sirf backend se
    match /reviews/{reviewId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    match /reviewOwners/{reviewId} {
      allow read, write: if false; // private owner mapping
    }

    match /reviewAnnotations/{reviewId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if false;
    }

    match /reviewAgentModels/{modelId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if false;
    }

    match /rateLimits/{uid} {
      allow read, write: if false; // backend bookkeeping
    }

    // ---------- ROOMS (CORE) ----------
    match /rooms/{roomId} {
      // Room ID random hai, list nahi ho sakta - invite link se hi join hota hai
      // Missing room ko "not found" dikhao, permission-denied nahi
      allow get: if signedIn() && (resource == null || isRoomMember(resource.data) || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if false; // backend: createRoom, joinRoom, startRoom, playMove, rematch, leaveRoom

      // Presence - kaun room me hai
      match /presence/{uid} {
        function roomData() {
          return get(/databases/$(database)/documents/rooms/$(roomId)).data;
        }
        allow get, list: if signedIn() && (isRoomMember(roomData()) || isAdmin());
        allow create, update: if signedIn()
          && request.auth.uid == uid
          && isRoomMember(roomData())
          && request.resource.data.keys().hasOnly(['status', 'lastSeenAt'])
          && request.resource.data.status in ['here', 'left']
          && request.resource.data.lastSeenAt == request.time; // server time only
        allow delete: if signedIn() && (request.auth.uid == uid || isAdmin());
      }

      // Private view - Sea Battle fleet etc, sirf owner dekh sakta hai
      match /views/{uid} {
        allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
        allow list: if isAdmin();
        allow create, update, delete: if false;
      }

      // Secret - codebreaker code, fleet positions, quiz answers - koi client nahi padh sakta
      match /secrets/{document} {
        allow read, write: if false;
      }

      // Chat - ephemeral, match khatam hote hi delete ho jata hai
      match /chat/{messageId} {
        function roomData() {
          return get(/databases/$(database)/documents/rooms/$(roomId)).data;
        }
        allow get, list: if signedIn() && (isRoomMember(roomData()) || isAdmin());
        allow create, update, delete: if false; // backend: sendChat
      }
    }
  }
}
