rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: is the request authenticated?
    function isAuth() {
      return request.auth != null;
    }

    // Helper: is this the admin?
    function isAdmin() {
      return isAuth() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.admin == true;
    }

    // Helper: does this room exist and is the user a member?
    function isRoomMember(roomId) {
      return isAuth() && exists(/databases/$(database)/documents/rooms/$(roomId))
        && request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.playerUids;
    }

    // Admin flags: only admins can read; no client writes
    match /admins/{uid} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Profiles: owner can read own; no client writes
    match /profiles/{uid} {
      allow read: if isAuth() && request.auth.uid == uid;
      allow list: if false;
      allow write: if false;
    }

    // Usernames: no client reads or writes
    match /usernames/{username} {
      allow read: if false;
      allow write: if false;
    }

    // Rooms: members can read; no client writes
    match /rooms/{roomId} {
      allow read: if isAuth() && (request.auth.uid in resource.data.playerUids || isAdmin());
      allow write: if false;

      // Presence: members can write their own heartbeat
      match /presence/{uid} {
        allow read: if isRoomMember(roomId);
        allow create, update: if isAuth()
          && request.auth.uid == uid
          && isRoomMember(roomId)
          && request.resource.data.keys().hasOnly(['status', 'lastSeenAt'])
          && request.resource.data.status in ['here', 'left']
          && request.resource.data.lastSeenAt == request.time;
        allow delete: if false;
      }

      // Private views: owner can read, no client writes
      match /views/{uid} {
        allow read: if isAuth() && request.auth.uid == uid;
        allow write: if false;
      }
    }

    // Friend requests: only participants can read
    match /friendRequests/{requestId} {
      allow read: if isAuth() && (request.auth.uid == resource.data.fromUid || request.auth.uid == resource.data.toUid);
      allow write: if false;
    }

    // Friendships: only the two friends can read
    match /friendships/{friendshipId} {
      allow read: if isAuth() && request.auth.uid in resource.data.members;
      allow write: if false;
    }

    // Game invites: only the recipient can read
    match /gameInvites/{inviteId} {
      allow read: if isAuth() && request.auth.uid == resource.data.toUid;
      allow write: if false;
    }

    // Blocks: only the blocker can read
    match /blocks/{blockId} {
      allow read: if isAuth() && request.auth.uid == resource.data.blockerUid;
      allow write: if false;
    }

    // Reports: only admins can read
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Reviews: public reads of approved reviews; no client writes
    match /reviews/{reviewId} {
      allow read: if resource.data.approved == true || isAdmin();
      allow write: if false;
    }

    // Rate limits: no client reads or writes
    match /rateLimits/{docId} {
      allow read: if false;
      allow write: if false;
    }

    // Maintenance: public read; no client writes
    match /siteStatus/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Maintenance access: only admins can read
    match /maintenanceAccess/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}